# 이 파일을 .env.local 로 복사한 뒤 값을 채운다. .env.local 은 git에 올라가지 않는다.
# Supabase 프로젝트 > Project Settings > API 에서 확인한다.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# 로그인 상태 쿠키를 서명하는 비밀 문자열 (32자 이상). 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# 브라우저 알림(웹 푸시)용 키. 아래 명령으로 만든다: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:lifelog@example.com
# 정해진 시각에 알림 확인을 부르는 스케줄러가 쓰는 비밀 문자열 (32자 이상)
CRON_SECRET=
